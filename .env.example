# Copy this file to .env and paste your keys. Never share or commit .env.

# --- LLM (required) ----------------------------------------------------------
# Groq (free tier) - get a key at https://console.groq.com/keys
LLM_API_KEY=paste_your_groq_key_here
# Optional - defaults shown. Any OpenAI-compatible provider works.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# --- Supabase (optional) -----------------------------------------------------
# Leave empty to store vectors in a local JSON file.
# Set both to store documents + vectors in Supabase (needed for uploads on Vercel).
# Supabase -> Project Settings -> API Keys. Use the SECRET key (server only, never in the browser).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
