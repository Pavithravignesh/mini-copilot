# Copy this file to .env and paste your key. Never share or commit .env.
# Any OpenAI-compatible provider works; change these lines to switch.

# Groq (free tier) - get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste_your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b
